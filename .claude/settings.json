{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(wc:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(sed -n:*)",
      "Bash(git grep:*)",
      "Bash(git show:*)",
      "Bash(./gradlew test:*)",
      "Bash(./gradlew build:*)",
      "Bash(./gradlew check:*)",
      "Bash(./gradlew classes:*)",
      "Bash(./gradlew javadoc:*)",
      "Bash(./gradlew spotbugsMain:*)",
      "Bash(./gradlew jacocoTestReport:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git checkout -b:*)"
    ],
    "deny": [
      "Bash(sed -i:*)",
      "Bash(find * -delete:*)",
      "Bash(find * -exec:*)",
      "Bash(rm -rf:*)",
      "Bash(git push:*)",
      "Bash(git reset --hard:*)",
      "Bash(git push --force:*)",
      "Read(./.env)"
    ]
  }
}
